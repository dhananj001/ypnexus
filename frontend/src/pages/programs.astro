                <span class="truncate max-w-[200px]">{prog.contact}</span>
                <a href="/contact" class="font-bold text-brand-dark hover:text-lime-hover transition-colors">
                  Register Now &rarr;
                </a>
              </div>
            </div>
          ))}
        </div>

      </div>
