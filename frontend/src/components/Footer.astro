---
// Section 5: Support & Footer (Finovate / UrbanGreen Aesthetic)
---

<!-- Support & Partnership Callout Strip -->
<section id="support" class="w-full py-16 sm:py-24 px-4 sm:px-6 lg:px-8 bg-brand-dark text-white">
  <div class="reveal-item max-w-7xl mx-auto rounded-3xl sm:rounded-4xl p-8 sm:p-14 bg-gradient-to-br from-brand-forest/60 to-brand-dark border border-white/10 shadow-float relative overflow-hidden">
    
    <div class="max-w-3xl space-y-6 relative z-10">
      <span class="inline-block px-3.5 py-1 rounded-full text-xs font-mono font-bold uppercase tracking-wider bg-lime-accent text-ink-900">
        Support The Mission
      </span>

      <h2 class="font-display text-3xl sm:text-5xl font-black leading-tight tracking-tight text-white">
        Join hands to nurture ecologically conscious, self-reliant futures.
      </h2>

      <p class="text-sm sm:text-base text-white/80 leading-relaxed font-normal max-w-xl">
        YP Nexus Foundation relies on citizen participation, contributions, and volunteer partnerships to keep our open schooling accessible to every deserving child and protect native ecosystems in Pune.
      </p>

      <div class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5">
        <a 
          href="#contact" 
          class="inline-flex items-center justify-center h-12 px-7 rounded-full text-xs sm:text-sm font-bold uppercase tracking-wider text-ink-900 bg-lime-accent hover:bg-lime-hover active:scale-[0.98] shadow-md transition-all"
        >
          Contribute / Donate
        </a>

        <a 
          href="#contact" 
          class="inline-flex items-center justify-center h-12 px-7 rounded-full text-xs sm:text-sm font-semibold uppercase tracking-wider text-white bg-white/10 hover:bg-white/20 active:scale-[0.98] border border-white/20 backdrop-blur-md transition-all"
        >
          Become a Mentor or Volunteer
        </a>
      </div>
    </div>

  </div>
</section>

<!-- Footer with Trust Details -->
<footer id="contact" class="bg-brand-dark text-white pt-16 pb-12 border-t border-white/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 pb-12 border-b border-white/10">
      
      <!-- Brand & Mission Column -->
      <div class="reveal-item reveal-delay-1 lg:col-span-5 space-y-4">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-full bg-lime-accent flex items-center justify-center font-bold text-ink-900 text-sm">
            ✳
          </div>
          <span class="font-display text-xl sm:text-2xl font-bold text-white tracking-tight">
            YP Nexus Foundation
          </span>
        </div>
        <p class="text-xs sm:text-sm text-white/70 leading-relaxed max-w-sm">
          A registered charitable trust in Pune, India pioneering alternatives towards ecologically sensitive life, experiential learning, and community habitats.
        </p>
        <div class="text-[11px] font-mono text-lime-accent/90">
          Trust Reg: Pune / Maharashtra • Established by Compeer Citizens
        </div>
      </div>

      <!-- Quick Navigation Links -->
      <div class="reveal-item reveal-delay-2 lg:col-span-3 space-y-3">
        <div class="font-display text-sm font-bold uppercase tracking-wider text-white">
          Core Initiatives
        </div>
        <ul class="space-y-2 text-xs sm:text-sm text-white/70">
          <li><a href="#paryay-dschool" class="hover:text-lime-accent transition-colors">Paryay Dschool</a></li>
          <li><a href="#initiatives" class="hover:text-lime-accent transition-colors">PiSELT Leadership</a></li>
          <li><a href="#initiatives" class="hover:text-lime-accent transition-colors">TurTle Media</a></li>
          <li><a href="#initiatives" class="hover:text-lime-accent transition-colors">BalMitee Habitat</a></li>
          <li><a href="#faq" class="hover:text-lime-accent transition-colors">Frequently Asked Questions</a></li>
        </ul>
      </div>

      <!-- Direct Contact Column -->
      <div class="reveal-item reveal-delay-3 lg:col-span-4 space-y-3">
        <div class="font-display text-sm font-bold uppercase tracking-wider text-white">
          Pune Center &amp; Inquiries
        </div>
        <p class="text-xs sm:text-sm text-white/70 leading-relaxed">
          Reach out for admissions, study tour collaborations, research partnerships, or donations.
        </p>
        <div class="space-y-2 text-xs sm:text-sm text-white/80">
          <div class="flex items-center gap-2">
            <span class="text-lime-accent">📍</span>
            <span>Pune, Maharashtra, India</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-lime-accent">🌐</span>
            <a href="https://ypnexus.org" class="hover:text-lime-accent transition-colors underline underline-offset-2">ypnexus.org</a>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-lime-accent">📖</span>
            <a href="https://ecotude.wordpress.com/" target="_blank" rel="noopener noreferrer" class="hover:text-lime-accent transition-colors">ecotude.wordpress.com &nearr;</a>
          </div>
        </div>
      </div>

    </div>

    <!-- Sub-footer -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-white/50 gap-4">
      <div>
        &copy; {new Date().getFullYear()} YP Nexus Foundation (Paryay Parisanstha). All rights reserved.
      </div>
      <div class="flex items-center gap-4 text-[11px] font-mono">
        <span>ALTERNATIVE LEARNING</span>
        <span>•</span>
        <span>ECOLOGICAL LIVING</span>
      </div>
    </div>

  </div>
</footer>
