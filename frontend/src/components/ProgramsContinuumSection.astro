---

<section id="programs" class="w-full py-16 sm:py-24 px-4 sm:px-6 lg:px-8 bg-white border-b border-ink-200">
  <div class="max-w-7xl mx-auto space-y-12 sm:space-y-16">
    
    <!-- Section Header -->
    <div class="reveal-item flex flex-col md:flex-row md:items-end justify-between gap-6 pb-6 border-b border-ink-200">
      <div class="max-w-3xl space-y-3">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-lime-subtle border border-lime-accent/50 text-[11px] font-mono uppercase tracking-wider text-brand-dark font-bold">
          <span>03 / Complete Learning Continuum</span>
        </div>
        <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold text-ink-900 tracking-tight leading-[1.12]">
          Our Programs: Learning across every life stage.
        </h2>
        <p class="text-base sm:text-lg text-ink-700 leading-relaxed">
          From formative early childhood habitat learning to open university fellowships, our educational structure develops self-reliance without the artificial walls of rote exams.
        </p>
      </div>

      <div class="flex items-center gap-2 text-xs font-mono text-ink-500">
        <span class="w-2 h-2 rounded-full bg-lime-accent animate-pulse"></span>
        <span>6 Structured Tiers • Pune Center</span>
      </div>
    </div>

    <!-- Programs Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
      {programs.map((prog, idx) => (
        <div class={`reveal-item reveal-delay-${(idx % 3) + 1} bg-canvas rounded-3xl p-6 sm:p-7 border border-ink-200/90 shadow-xs flex flex-col justify-between group hover:border-lime-accent hover:shadow-card transition-all duration-300`}>
          <div class="space-y-4">
            
            <!-- Banner / Graphic -->
            <div class="w-full aspect-[16/9] rounded-2xl overflow-hidden bg-white border border-ink-200/80 relative">
              <img 
                src={prog.banner} 
                alt={`${prog.title} official banner`} 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
              <span class="absolute top-2.5 left-2.5 px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold bg-brand-dark/90 text-white backdrop-blur-xs">
                {prog.marathi}
              </span>
            </div>

            <!-- Header Titles -->
            <div class="space-y-1">
              <span class="text-[10px] font-mono uppercase tracking-wider font-bold text-brand-forest">
                {prog.tag}
              </span>
              <h3 class="font-display text-2xl font-black text-ink-900 tracking-tight">
                {prog.title}
              </h3>
              <p class="text-xs font-semibold text-ink-600 font-sans">
                {prog.subtitle}
              </p>
            </div>

            <!-- Description -->
            <p class="text-xs sm:text-sm text-ink-700 leading-relaxed">
              {prog.description}
            </p>

            <!-- Bullets from Authentic Materials -->
            <ul class="space-y-1.5 pt-2 border-t border-ink-200/60">
              {prog.bullets.map((b) => (
                <li class="flex items-start gap-2 text-xs text-ink-800 leading-snug">
                  <span class="text-brand-forest font-bold shrink-0">•</span>
                  <span>{b}</span>
                </li>
              ))}
            </ul>

          </div>

          <!-- Bottom Footer -->
          <div class="mt-6 pt-3 border-t border-ink-200 flex items-center justify-between text-[11px] font-mono text-ink-500">
            <span>{prog.contact}</span>
            <a 
              href="#contact" 
              class="font-bold text-brand-dark hover:text-lime-hover transition-colors flex items-center gap-1"
            >
              Inquire &rarr;
            </a>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>

